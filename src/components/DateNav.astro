---
// Strip navigasi tanggal: H-3 s/d H+7 dari HARI INI.
// Label relatif untuk Kemarin / Hari Ini / Besok / Lusa, selebihnya tanggal.
// Props: date (YYYY-MM-DD yang sedang dilihat), makeUrl(tanggal) => string.
interface Props {
  date: string;
  makeUrl: (d: string) => string;
}
const { date, makeUrl } = Astro.props;

const OFFSETS = [-3, -2, -1, 0, 1, 2, 3, 4, 5, 6, 7];

function shift(dateISO: string, days: number): string {
  const d = new Date(`${dateISO}T12:00:00+07:00`).getTime() + days * 86400000;
  const wib = new Date(d + (7 * 60 + new Date(d).getTimezoneOffset()) * 60000);
  return wib.toISOString().slice(0, 10);
}
function todayWIB(): string {
  const n = Date.now();
  return new Date(n + (7 * 60 + new Date(n).getTimezoneOffset()) * 60000).toISOString().slice(0, 10);
}
const today = todayWIB();

function relLabel(off: number): string | null {
  if (off === -1) return 'Kemarin';
  if (off === 0) return 'Hari Ini';
  if (off === 1) return 'Besok';
  if (off === 2) return 'Lusa';
  return null;
}
function dayName(dateISO: string): string {
  return new Intl.DateTimeFormat('id-ID', { weekday: 'short', timeZone: 'Asia/Jakarta' }).format(
    new Date(`${dateISO}T12:00:00+07:00`),
  );
}
function dayNum(dateISO: string): string {
  return new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', timeZone: 'Asia/Jakarta' }).format(
    new Date(`${dateISO}T12:00:00+07:00`),
  );
}
---
<div class="datestrip-wrap">
  <div class="datestrip" role="navigation" aria-label="Pilih tanggal">
    {OFFSETS.map((off) => {
      const d = shift(today, off);
      const rel = relLabel(off);
      const active = d === date;
      return (
        <a
          class={`dchip ${active ? 'active' : ''} ${off === 0 ? 'istoday' : ''}`}
          href={makeUrl(d)}
          aria-current={active ? 'date' : undefined}
          title={d}
        >
          <span class="d-top">{rel ?? dayName(d)}</span>
          <span class="d-sub">{dayNum(d)}</span>
        </a>
      );
    })}
  </div>
  <form method="get" class="datenav-pick" id="datenav-form" title="Lompat ke tanggal lain">
    <input type="date" name="date" value={date} min="2026-08-01" max="2030-12-31" onchange="this.form.submit()" aria-label="Pilih tanggal lain" />
  </form>
</div>
<script is:inline>
  // pertahankan query lain (mis. ?q= / ?kategori=) saat ganti tanggal via date picker
  (() => {
    const form = document.getElementById('datenav-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    const params = new URLSearchParams(location.search);
    for (const [k, v] of params) {
      if (k === 'date') continue;
      const h = document.createElement('input');
      h.type = 'hidden'; h.name = k; h.value = v;
      form.appendChild(h);
    }
  })();
</script>
