---
import Layout from '../../layouts/Layout.astro';
import DateNav from '../../components/DateNav.astro';
import { CATEGORIES, channelsByCategory } from '../../lib/channels';
import { getDaySchedule, isLive, todayWIB } from '../../lib/epg';
import type { Category } from '../../lib/channels';

export const prerender = false;

const env = (Astro.locals as unknown as { runtime?: { env?: Record<string, string> } }).runtime?.env ?? {};
const { slug } = Astro.params;
const cat = (['nasional', 'paytv', 'internasional'].includes(slug ?? '') ? slug : 'nasional') as Category;
const meta = CATEGORIES.find((c) => c.slug === cat)!;
const dateParam = Astro.url.searchParams.get('date');
const date = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : todayWIB();

const day = await getDaySchedule(env, date).catch(() => null);
const list = channelsByCategory(cat);
const nowMs = Date.now();
const schedBySlug = new Map((day?.channels ?? []).map((c) => [c.slug, c]));
---

<Layout title={`${meta.name} | Haru EPG`} description={meta.description}>
  <section class="hero">
    <h1>{meta.name}</h1>
    <p>{meta.description} · {day?.label ?? date}</p>
    <div class="meta">
      {CATEGORIES.map((c) => (
        <a class="pill" style={`text-decoration:none;${c.slug === cat ? 'background:#fff;color:#7c3aed' : ''}`} href={`/kategori/${c.slug}?date=${date}`}>{c.name}</a>
      ))}
    </div>
  </section>

  <DateNav date={date} makeUrl={(d) => `/kategori/${cat}?date=${d}`} />

  <div class="grid-channels">
    {list.map((ch) => {
      const sched = schedBySlug.get(ch.slug);
      const progs = sched?.programs ?? [];
      const live = sched?.now && isLive(nowMs, sched.now);
      // Sedang tayang → tampilkan itu; jeda/kosong → tampilkan acara berikutnya
      const feat = live ? sched!.now! : (sched?.next ?? sched?.now);
      return (
        <article class="card">
          <div class="card-head">
            <span class="avatar">{ch.name.slice(0, 2)}{ch.logo && <img src={ch.logo} alt={ch.name} loading="lazy" onerror="this.remove()" />}</span>
            <div>
              <h3><a href={`/channel/${ch.slug}?date=${date}`}>{ch.name}</a></h3>
              <span class="sub">{progs.length} acara {live ? '· 🔴 LIVE' : ''}</span>
            </div>
            <span style="flex:1"></span>
            {live && <span class="live-badge"><span class="live-dot"></span>LIVE</span>}
          </div>
          {feat ? (
            <div class={`now-box ${live ? 'live' : ''}`}>
              <div class="prog-time">{live ? 'SEDANG TAYANG' : 'BERIKUTNYA'} · {feat.startLabel} – {feat.endLabel}</div>
              <div class="prog-title"><a href={`/program/${feat.slug}?date=${date}`}>{feat.title}</a></div>
            </div>
          ) : (
            <div class="now-box"><div class="prog-time">{progs.length === 0 ? 'Belum ada data' : 'Selesai / belum mulai'}</div></div>
          )}
          <div style="padding:12px 14px 14px">
            <a class="btn" style="display:block;text-align:center;text-decoration:none" href={`/channel/${ch.slug}?date=${date}`}>Jadwal lengkap →</a>
          </div>
        </article>
      );
    })}
  </div>
</Layout>
