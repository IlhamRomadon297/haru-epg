---
import Layout from '../layouts/Layout.astro';
import DateNav from '../components/DateNav.astro';
import { getDaySchedule, isLive, progress, todayWIB } from '../lib/epg';
import { CATEGORIES, categoryLabel } from '../lib/channels';

export const prerender = false;

const env = (Astro.locals as unknown as { runtime?: { env?: Record<string, string> } }).runtime?.env ?? {};
const dateParam = Astro.url.searchParams.get('date');
const catParam = Astro.url.searchParams.get('kategori');
const date = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : todayWIB();

let day;
try {
  day = await getDaySchedule(env, date);
} catch (e) {
  day = { date, label: date, channels: [], totalPrograms: 0, cachedAt: '', source: 'fallback' as const };
}

const validCat = ['nasional', 'paytv', 'internasional'].includes(catParam ?? '');
const channels = validCat ? day.channels.filter((c) => c.category === catParam) : day.channels;
const withPrograms = channels.filter((c) => c.programs.length > 0);
const nowMs = Date.now();
const liveCount = channels.filter((c) => c.now).length;
---

<Layout title={`Haru EPG | Jadwal TV Hari Ini (${day.label})`}>
  <section class="hero">
    <h1>📺 Jadwal TV Hari Ini</h1>
    <p>{day.label} · {channels.length} channel · {day.totalPrograms} acara · sumber cache {day.source === 'cache' ? '⚡ instan' : '🔄 live'}</p>
    <div class="meta">
      <span class="pill">🔴 {liveCount} LIVE sekarang</span>
      <span class="pill">⚡ Cache 1–2 jam</span>
      <span class="pill">🌙 Dark mode ready</span>
    </div>
  </section>

  <DateNav date={day.date} makeUrl={(d) => (validCat ? `/?kategori=${catParam}&date=${d}` : `/?date=${d}`)} />

  <div class="filter-row" style="margin-bottom:14px">
    <a class={`chip ${!validCat ? 'active' : ''}`} href={dateParam ? `/?date=${day.date}` : '/'}>Semua</a>
    {CATEGORIES.map((c) => (
      <a class={`chip ${catParam === c.slug ? 'active' : ''}`} href={`/?kategori=${c.slug}&date=${day.date}`}>{c.name}</a>
    ))}
  </div>

  {withPrograms.length === 0 ? (
    <div class="card empty">
      <h3>Jadwal belum tersedia 😴</h3>
      <p>Sumber sedang tidak bisa dijangkau / tanggal di luar jangkauan (arsip H-3 s/d H+10). Coba tanggal lain.</p>
      <p style="font-size:.8rem">Tanggal: {day.date} · <a href="/api/schedule?date={day.date}">cek API</a></p>
    </div>
  ) : (
    <div class="grid-channels">
      {withPrograms.map((ch) => {
        const live = ch.now && isLive(nowMs, ch.now);
        // Sedang tayang → tampilkan itu; jeda/kosong → tampilkan acara berikutnya
        const feat = live ? ch.now! : (ch.next ?? ch.now);
        const pct = live ? progress(nowMs, ch.now!) : 0;
        return (
          <article class="card">
            <div class="card-head">
              <span class="avatar">{ch.name.slice(0, 2)}{ch.logo && <img src={ch.logo} alt={ch.name} loading="lazy" onerror="this.remove()" />}</span>
              <div>
                <h3><a href={`/channel/${ch.slug}?date=${day.date}`}>{ch.name}</a></h3>
                <span class="sub">{categoryLabel(ch.category)} · {ch.programs.length} acara</span>
              </div>
              <span style="flex:1"></span>
              {live && <span class="live-badge"><span class="live-dot"></span>LIVE</span>}
            </div>
            {feat && (
              <div class={`now-box ${live ? 'live' : ''}`}>
                <div class="prog-time">{live ? 'SEDANG TAYANG' : 'BERIKUTNYA'} · {feat.startLabel} – {feat.endLabel}</div>
                <div class="prog-title"><a href={`/program/${feat.slug}?date=${day.date}`}>{feat.title}</a></div>
                {live && <div class="progress"><div style={`width:${pct.toFixed(1)}%`}></div></div>}
              </div>
            )}
            <ul class="timeline">
              {ch.programs.slice(0, 8).map((p) => {
                const cur = isLive(nowMs, p);
                return (
                  <li class={cur ? 'current' : ''}>
                    <span class="t-time">{p.startLabel.replace(' WIB','')}</span>
                    <div class="t-title">
                      {cur && <span class="live-badge" style="font-size:.62rem">LIVE</span>}
                      <a href={`/program/${p.slug}?date=${day.date}`}>{p.title}</a>
                      {p.description && <div class="t-desc">{p.description}</div>}
                    </div>
                  </li>
                );
              })}
            </ul>
            <div style="padding:0 14px 14px">
              <a class="btn" style="display:block;text-align:center;text-decoration:none" href={`/channel/${ch.slug}?date=${day.date}`}>Jadwal lengkap →</a>
            </div>
          </article>
        );
      })}
    </div>
  )}
</Layout>
