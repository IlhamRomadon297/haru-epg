---
import Layout from '../../layouts/Layout.astro';
import { getChannelSchedule, isLive, progress, todayWIB } from '../../lib/epg';

export const prerender = false;

const env = (Astro.locals as unknown as { runtime?: { env?: Record<string, string> } }).runtime?.env ?? {};
const { slug } = Astro.params;
const dateParam = Astro.url.searchParams.get('date');
const date = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : todayWIB();

const result = await getChannelSchedule(env, slug ?? '', date);
if (!result) {
  return Astro.redirect('/cari?q=' + encodeURIComponent(slug ?? ''));
}
const { channel, label } = result;
const nowMs = Date.now();
---

<Layout title={`Jadwal ${channel.name} Hari Ini — Haru EPG`} description={`Jadwal acara ${channel.name} ${label}, lengkap dengan status LIVE.`}>
  <section class="hero">
    <div style="display:flex;gap:14px;align-items:center">
      <span class="avatar" style="width:58px;height:58px;background:rgba(255,255,255,.9)">{channel.logo ? <img src={channel.logo} alt={channel.name} /> : channel.name.slice(0,2)}</span>
      <div>
        <h1 style="margin:0">Jadwal {channel.name}</h1>
        <p>{label} · {channel.programs.length} acara · {channel.category}</p>
      </div>
    </div>
  </section>

  <div class="toolbar">
    <form method="get" style="display:flex;gap:8px;align-items:center">
      <input type="date" name="date" value={date} />
      <button class="btn primary" type="submit">Lihat</button>
      <a class="btn" href={`/channel/${channel.slug}`}>Hari ini</a>
      <a class="btn" href={`/?kategori=${channel.category}`}>← {channel.category}</a>
    </form>
  </div>

  {channel.programs.length === 0 ? (
    <div class="card empty">
      <h3>Belum ada jadwal untuk tanggal ini</h3>
      <p>Channel {channel.name} belum punya data {label}. Coba tanggal lain.</p>
    </div>
  ) : (
    <div class="card">
      <ul class="timeline" style="padding:10px 18px 18px">
        {channel.programs.map((p) => {
          const cur = isLive(nowMs, p);
          const pct = cur ? progress(nowMs, p) : 0;
          return (
            <li class={cur ? 'current' : ''} style="padding:12px 0">
              <span class="t-time">{p.startLabel.replace(' WIB','')}<br/><span style="color:var(--muted);font-weight:600">s/d {p.endLabel.replace(' WIB','')}</span></span>
              <div class="t-title" style="flex:1">
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                  {cur && <span class="live-badge"><span class="live-dot"></span>LIVE</span>}
                  {p.manual && <span class="pill light" style="font-size:.68rem">✏️ manual</span>}
                  <a href={`/program/${p.slug}?date=${date}`} style="font-weight:800;font-size:1rem">{p.title}</a>
                </div>
                {cur && <div class="progress"><div style={`width:${pct.toFixed(1)}%`}></div></div>}
                {p.description && <div class="t-desc" style="-webkit-line-clamp:3">{p.description}</div>}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  )}
</Layout>
