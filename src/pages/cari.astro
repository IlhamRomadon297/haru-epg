---
import Layout from '../layouts/Layout.astro';
import DateNav from '../components/DateNav.astro';
import { CHANNELS, categoryLabel } from '../lib/channels';
import { getDaySchedule, isLive, todayWIB } from '../lib/epg';

export const prerender = false;

const env = (Astro.locals as unknown as { runtime?: { env?: Record<string, string> } }).runtime?.env ?? {};
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const dateParam = Astro.url.searchParams.get('date');
const date = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : todayWIB();

type Progs = Awaited<ReturnType<typeof getDaySchedule>>['channels'][number]['programs'];
let results: Progs = [];
let day: Awaited<ReturnType<typeof getDaySchedule>> | null = null;
let label = date;
let foundChannels: ReturnType<typeof getDaySchedule>['channels'][number][] = [];

const ql = q.toLowerCase();
if (q.length >= 1) {
  day = await getDaySchedule(env, date).catch(() => null);
  if (day) {
    label = day.label;
    // 1) Channel yang namanya cocok
    const byName = CHANNELS.filter((c) => c.name.toLowerCase().includes(ql) || c.slug.includes(ql));
    const byCat = CHANNELS.filter((c) => categoryLabel(c.category).toLowerCase().includes(ql));
    const chSlugs = new Set([...byName, ...byCat].slice(0, 20).map((c) => c.slug));
    foundChannels = day.channels
      .filter((c) => chSlugs.has(c.slug))
      .sort((a, b) => {
        const an = a.name.toLowerCase();
        const bn = b.name.toLowerCase();
        return an.indexOf(ql) - bn.indexOf(ql) || an.localeCompare(bn);
      })
      .slice(0, 12);

    // 2) Acara yang cocok — diranking: judul-prefix > judul mengandung > nama channel > deskripsi
    const rank = (p: Progs[number] & { channelName: string }): number => {
      const t = p.title.toLowerCase();
      const chn = p.channelName.toLowerCase();
      if (t.startsWith(ql)) return 0;
      if (t.includes(ql)) return 1;
      if (chn.includes(ql)) return 2;
      if ((p.description ?? '').toLowerCase().includes(ql)) return 3;
      return 4;
    };
    results = day.channels
      .flatMap((c) => c.programs)
      .filter((p) => rank(p) < 4)
      .sort((a, b) => rank(a) - rank(b) || a.start.localeCompare(b.start))
      .slice(0, 120);
  }
}
const nowMs = Date.now();
---

<Layout title={q ? `Cari "${q}" | Haru EPG` : 'Pencarian | Haru EPG'}>
  <section class="hero">
    <h1>🔍 Pencarian</h1>
    <p>
      {q
        ? `Hasil untuk "${q}" · ${label} · ${foundChannels.length} channel · ${results.length} acara`
        : 'Ketikkan nama channel atau judul acara — saran channel muncul langsung saat mengetik.'}
    </p>
  </section>

  <form class="toolbar" method="get" action="/cari" role="search">
    <input name="q" value={q} data-ac="channel" placeholder="Cari channel / acara…" style="flex:1;min-width:200px;background:var(--surface);border:1px solid var(--border);border-radius:999px;padding:10px 16px;color:var(--text)" autocomplete="off" />
    <input type="hidden" name="date" value={date} />
    <button class="btn primary" type="submit">Cari</button>
  </form>

  <DateNav date={date} makeUrl={(d) => `/cari?q=${encodeURIComponent(q)}&date=${d}`} />

  {q.length >= 1 && day && (
    (foundChannels.length === 0 && results.length === 0) ? (
      <div class="card empty"><h3>Tidak ketemu 😅</h3><p>Coba kata kunci lain atau ganti tanggal.</p></div>
    ) : (
      <>
        {foundChannels.length > 0 && (
          <div style="margin:14px 0">
            <h3 style="margin:0 0 10px;font-size:1rem">Channel ({foundChannels.length})</h3>
            <div class="grid-channels">
              {foundChannels.map((ch) => {
                const live = ch.now && isLive(nowMs, ch.now);
                return (
                  <article class="card">
                    <div class="card-head">
                      <span class="avatar">{ch.name.slice(0, 2)}{ch.logo && <img src={ch.logo} alt={ch.name} loading="lazy" onerror="this.remove()" />}</span>
                      <div>
                        <h3><a href={`/channel/${ch.slug}?date=${date}`}>{ch.name}</a></h3>
                        <span class="sub">{categoryLabel(ch.category)} · {ch.programs.length} acara{live ? ' · 🔴 LIVE' : ''}</span>
                      </div>
                      <span style="flex:1"></span>
                      {live && <span class="live-badge"><span class="live-dot"></span>LIVE</span>}
                    </div>
                    <div style="padding:0 14px 14px">
                      <a class="btn" style="display:block;text-align:center;text-decoration:none" href={`/channel/${ch.slug}?date=${date}`}>Jadwal lengkap →</a>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        )}
        {results.length > 0 && (
          <div class="card" style="margin-top:18px">
            <h3 style="margin:16px 18px 0;font-size:1rem">Acara ({results.length})</h3>
            <ul class="timeline" style="padding:6px 18px 18px">
              {results.map((p) => {
                const cur = isLive(nowMs, p);
                return (
                  <li class={cur ? 'current' : ''}>
                    <span class="t-time">{p.startLabel.replace(' WIB', '')}<br/><span style="color:var(--muted)">{p.channelName}</span></span>
                    <div class="t-title">
                      {cur && <span class="live-badge" style="font-size:.62rem">LIVE</span>}
                      <a href={`/program/${p.slug}?date=${date}`} style="font-weight:700">{p.title}</a>
                      <div class="prog-time"><a href={`/channel/${p.channelSlug}?date=${date}`} style="text-decoration:none">{p.channelName}</a> · {p.startLabel}</div>
                      {p.description && <div class="t-desc">{p.description}</div>}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </>
    )
  )}
</Layout>